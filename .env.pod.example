NODE_ENV=production
PORT=3000

MONGODB_URI=mongodb://mongo:27017/strangerconfide

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.your-domain.com/api/auth/facebook/callback

FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com

CHAT_PRESENCE_TTL_MS=60000

UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=5

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=FindU <noreply@your-domain.com>

LIMIT_REQUEST=6000
MAX_MESSAGES_PER_MINUTE=60
MIN_MESSAGE_INTERVAL_MS=500
